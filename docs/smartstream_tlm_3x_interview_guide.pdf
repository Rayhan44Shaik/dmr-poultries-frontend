BT /F3 7.5 Tf 54.00 560.10 Td (CREATE OR REPLACE PROCEDURE validate_tlm_file_load\(p_file_name IN VARCHAR2\) AS) Tj ET
BT /F3 7.5 Tf 54.00 550.10 Td (  v_source_count NUMBER;) Tj ET
BT /F3 7.5 Tf 54.00 540.10 Td (  v_loaded_count NUMBER;) Tj ET
BT /F3 7.5 Tf 54.00 530.10 Td (BEGIN) Tj ET
BT /F3 7.5 Tf 54.00 520.10 Td (  SELECT <TRAILER_COUNT_COLUMN> INTO v_source_count) Tj ET
BT /F3 7.5 Tf 54.00 510.10 Td (  FROM <TLM_LOAD_BATCH_TABLE>) Tj ET
BT /F3 7.5 Tf 54.00 500.10 Td (  WHERE <FILE_NAME_COLUMN> = p_file_name;) Tj ET
BT /F1 5 Tf 44.00 490.10 Td () Tj ET
BT /F3 7.5 Tf 54.00 483.35 Td (  SELECT COUNT\(*\) INTO v_loaded_count) Tj ET
BT /F3 7.5 Tf 54.00 473.35 Td (  FROM <TLM_ITEM_TABLE> i) Tj ET
BT /F3 7.5 Tf 54.00 463.35 Td (  JOIN <TLM_LOAD_BATCH_TABLE> b ON b.<LOAD_ID_COLUMN> = i.<LOAD_ID_COLUMN>) Tj ET
BT /F3 7.5 Tf 54.00 453.35 Td (  WHERE b.<FILE_NAME_COLUMN> = p_file_name;) Tj ET
BT /F1 5 Tf 44.00 443.35 Td () Tj ET
BT /F3 7.5 Tf 54.00 436.60 Td (  IF v_source_count <> v_loaded_count THEN) Tj ET
BT /F3 7.5 Tf 54.00 426.60 Td (    DBMS_OUTPUT.PUT_LINE\('Count mismatch: source='||v_source_count||', ) Tj ET
BT /F3 7.5 Tf 54.00 416.60 Td (loaded='||v_loaded_count\);) Tj ET
BT /F3 7.5 Tf 54.00 406.60 Td (  ELSE) Tj ET
BT /F3 7.5 Tf 54.00 396.60 Td (    DBMS_OUTPUT.PUT_LINE\('Counts matched'\);) Tj ET
BT /F3 7.5 Tf 54.00 386.60 Td (  END IF;) Tj ET
BT /F3 7.5 Tf 54.00 376.60 Td (EXCEPTION) Tj ET
BT /F3 7.5 Tf 54.00 366.60 Td (  WHEN NO_DATA_FOUND THEN) Tj ET
BT /F3 7.5 Tf 54.00 356.60 Td (    DBMS_OUTPUT.PUT_LINE\('File not found in verified load metadata'\);) Tj ET
BT /F3 7.5 Tf 54.00 346.60 Td (  WHEN OTHERS THEN) Tj ET
BT /F3 7.5 Tf 54.00 336.60 Td (    DBMS_OUTPUT.PUT_LINE\('Error: '||SQLERRM\);) Tj ET
BT /F3 7.5 Tf 54.00 326.60 Td (    RAISE;) Tj ET
BT /F3 7.5 Tf 54.00 316.60 Td (END;) Tj ET
BT /F3 7.5 Tf 54.00 306.60 Td (/) Tj ET
