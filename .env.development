# Committed on purpose: these defaults apply to `npm run dev` only. Production
# builds read .env / .env.production, which never define these flags.

# `npm run dev` boots the quarter sample API (scripts/quarter-sample-data.mjs)
# next to Vite, so every module renders populated without PostgreSQL.
VITE_API_BASE_URL=/api

# Skip the login gate in dev: ?demo=1 / VITE_DEMO_MODE only take effect when
# import.meta.env.DEV is true, so a production build can never bypass auth.
VITE_DEMO_MODE=1
