# Committed on purpose: these defaults apply to `npm run dev` only. Production
# builds read .env / .env.production, which never define these flags.

# `npm run dev` boots the quarter sample API (scripts/quarter-sample-data.mjs)
# next to Vite, so every module renders populated without PostgreSQL.
VITE_API_BASE_URL=/api

# Sign-in gate is ON in dev: the app opens on the login page with the two
# roles (owner / supervisor). An explicit ?demo=1 URL param still lets a
# developer skip the gate for UI previews — import.meta.env.DEV guards it,
# so a production build can never bypass auth.
VITE_DEMO_MODE=0
