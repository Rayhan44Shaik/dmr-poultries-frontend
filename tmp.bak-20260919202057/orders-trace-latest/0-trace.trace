ustify-content: center;\n        background: #ffffff;\n        font-family: \"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n        color: #0f172a;\n      }\n      #app-splash .splash-hen {\n        width: calc(112px * var(--dmr-font-scale, 1));\n        height: calc(112px * var(--dmr-font-scale, 1));\n        object-fit: contain;\n        animation: splash-bob 1.9s ease-in-out infinite;\n      }\n      #app-splash .splash-title {\n        margin-top: calc(20px * var(--dmr-font-scale, 1));\n        font-size: calc(30px * var(--dmr-font-scale, 1));\n        font-weight: 700;\n        letter-spacing: -0.02em;\n        color: #0f172a;\n      }\n      #app-splash .splash-track {\n        margin-top: calc(24px * var(--dmr-font-scale, 1));\n        width: 176px;\n        height: 4px;\n        border-radius: 999px;\n        background: #e2e8f0;\n        overflow: hidden;\n      }\n      #app-splash .splash-bar {\n        width: 33%;\n        height: 100%;\n        border-radius: 999px;\n        background: #059669;\n        animation: splash-bar 1.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;\n      }\n      #app-splash .splash-sub {\n        margin-top: calc(16px * var(--dmr-font-scale, 1));\n        font-size: calc(14px * var(--dmr-font-scale, 1));\n        font-weight: 500;\n        color: #64748b;\n      }\n      #app-splash .splash-dots span {\n        display: inline-block;\n        animation: splash-dot 1.4s ease-in-out infinite;\n      }\n      #app-splash .splash-dots span:nth-child(2) { animation-delay: 0.2s; }\n      #app-splash .splash-dots span:nth-child(3) { animation-delay: 0.4s; }\n      @keyframes splash-bob {\n        0%, 100% { transform: translateY(0) rotate(0deg); }\n        50% { transform: translateY(-10px) rotate(-2.5deg); }\n      }\n      @keyframes splash-bar {\n        0% { transform: translateX(-110%); }\n        100% { transform: translateX(340%); }\n      }\n      @keyframes splash-dot {\n        0%, 80%, 100% { opacity: 0.25; t