ustify-content: center;\n        background: #ffffff;\n        font-family: \"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n        color: #0f172a;\n      }\n      #app-splash .splash-hen {\n        width: calc(112px * var(--dmr-font-scale, 1));\n        height: calc(112px * var(--dmr-font-scale, 1));\n        object-fit: contain;\n        animation: splash-bob 1.9s ease-in-out infinite;\n      }\n      #app-splash .splash-title {\n        margin-top: calc(20px * var(--dmr-font-scale, 1));\n        font-size: calc(30px * var(--dmr-font-scale, 1));\n        font-weight: 700;\n        letter-spacing: -0.02em;\n        color: #0f172a;\n      }\n      #app-splash .splash-track {\n        margin-top: calc(24px * var(--dmr-font-scale, 1));\n        width: 176px;\n        height: 4px;\n        border-radius: 999px;\n        background: #e2e8f0;\n        overflow: hidden;\n      }\n      #app-splash .splash-bar {\n        width: 33%;\n        height: 100%;\n        border-radius: 999px;\n        background: #059669;\n        animation: splash-bar 1.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;\n      }\n      #app-splash .splash-sub {\n        margin-top: calc(16px * var(--dmr-font-scale, 1));\n        font-size: calc(14px * var(--dmr-font-scale, 1));\n        font-weight: 500;\n        color: #64748b;\n      }\n      #app-splash .splash-dots span {\n        display: inline-block;\n        animation: splash-dot 1.4s ease-in-out infinite;\n      }\n      #app-splash .splash-dots span:nth-child(2) { animation-delay: 0.2s; }\n      #app-splash .splash-dots span:nth-child(3) { animation-delay: 0.4s; }\n      @keyframes splash-bob {\n        0%, 100% { transform: translateY(0) rotate(0deg); }\n        50% { transform: translateY(-10px) rotate(-2.5deg); }\n      }\n      @keyframes splash-bar {\n        0% { transform: translateX(-110%); }\n        100% { transform: translateX(340%); }\n      }\n      @keyframes splash-dot {\n        0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }\n        40% { opacity: 1; transform: translateY(-3px); }\n      }\n      /* Watchdog escape hatch — shown only when loading takes pathologically\n         long (cold dev-server rebuild + slow tunnel). Never a dead end. */\n      #app-splash .splash-escape {\n        display: none;\n        margin-top: calc(24px * var(--dmr-font-scale, 1));\n        flex-direction: column;\n        align-items: center;\n        gap: 10px;\n      }\n      #app-splash .splash-escape.visible { display: flex; }\n      #app-splash .splash-escape button {\n        appearance: none;\n        border: none;\n        cursor: pointer;\n        padding: 10px 22px;\n        border-radius: 999px;\n        background: #059669;\n        color: #ffffff;\n        font-size: 14px;\n        font-weight: 600;\n        font-family: inherit;\n      }\n      #app-splash .splash-escape button:hover { background: #047857; }\n      #app-splash .splash-escape small { color: #94a3b8; font-size: 12px; }\n      @media (prefers-reduced-motion: reduce) {\n        #app-splash .splash-hen,\n        #app-splash .splash-bar,\n        #app-splash .splash-dots span { animation: none; }\n      }\n    "],"\n    ","\n    ",["LINK",{"rel":"modulepreload","crossorigin":"","href":"/assets/rolldown-runtime-aKtaBQYM.js"}],"\n    ",["LINK",{"rel":"modulepreload","crossorigin":"","href":"/assets/jsx-runtime-2Zwg-L3c.js"}],"\n    ",["LINK",{"rel":"modulepreload","crossorigin":"","href":"/assets/createLucideIcon-Cn8d9JH0.js"}],"\n    ",["LINK",{"rel":"stylesheet","crossorigin":"","href":"/assets/index-CXF9XtLO.css"}],"\n  ",["LINK",{"rel":"modulepreload","as":"script","crossorigin":"","href":"http://127.0.0.1:5174/assets/DashboardLayout-Ph0Qehj0.js"}],["LINK",{"rel":"modulepreload","as":"script","crossorigin":"","href":"http://127.0.0.1:5174/assets/chart-column-BDkgkoYj.js"}],["LINK",{"rel":"modulepreload","as":"script","crossorigin":"","href":"http://127.0.0.1:5174/assets/sprout-CUN_MDnh.js"}],["LINK",{"r