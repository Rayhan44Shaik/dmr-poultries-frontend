# Frontend (Vite) environment example
# Copy to .env.local if you need to override defaults.

# Backend API base URL (includes /api prefix)
VITE_API_BASE_URL=http://localhost:4000/api

# Optional request timeout in milliseconds
VITE_API_TIMEOUT_MS=30000

# Enable server-side Settings persistence only after the backend Settings API is implemented.
# Keep false until /api/settings and /api/settings/ai/test are available.
VITE_SETTINGS_API_ENABLED=false
